# Copy to .env and fill in. .env is git-ignored. deploy.sh passes it to the container.

# Google Cloud API key with the Google Drive API enabled: reads the song library from Drive
# (and is used by import_drive.py). The Drive folders must be shared "anyone with the link".
GOOGLE_API_KEY=

# The library's two Drive folders (required for a Drive library; the code's defaults are placeholders)
DRIVE_CHO_FOLDER_URL=
DRIVE_PDF_FOLDER_URL=
# How often to check Drive for changes, in minutes
# DRIVE_SYNC_MINUTES=5

# Or use a local folder as the library instead of Drive (then GOOGLE_API_KEY and the folders aren't needed)
# LIBRARY_DIR=examples/library

# Which library the site serves: "mirror" (default: the two folders above) or "sources"
# (three teams' folders, with arrangements; see docs/switch-over.md). Switching is a restart.
# LIBRARY_MODE=mirror
# How often the three-source library checks its sources, in minutes
# SOURCES_SYNC_MINUTES=60

# Where sets and share links are stored (default: data/sets.db, in the yfm-data volume in Docker)
# SETS_DB=data/sets.db
# Share links (and set links) are copied as <this>#s=<code>. Use an address that redirects
# here, e.g. a church site's; the #... part survives the redirect. Default: this site's own.
# SHARE_LINK_BASE=https://example.org/songlibrary

# Password for the web app (recommended for any public deployment)
# APP_PASSWORD=

# import_drive.py: the shared Drive folder to import from
# DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/...?resourcekey=...
# Which top-level folders to import (regex on folder names)
# DRIVE_INCLUDE=song|composition|hymn|music book|vocal

# Usage stats: the private page /stats (any user name, this password). Unset: no stats page,
# though events are still recorded. Events live in EVENTS_DB (default data/events.db).
# STATS_PASSWORD=
# EVENTS_DB=data/events.db
